{
  "info": {
    "name": "Disc Golf Bag Tips API",
    "description": "Generated from the live OpenAPI document at /v3/api-docs, so it cannot drift from the code. Regenerate with `python3 docs/postman/generate.py`.\n\nEvery request body is runnable as-is rather than a schema stub.\n\nSession: the analysis and profile endpoints use a `BAGTIPS_SESSION` cookie. Postman keeps cookies per domain automatically, so saving a bag and listing it back works without configuration.\n\nVariables: `baseUrl` and `adminToken` (matches `bagtips.admin-token`; the local profile uses `local-dev-token`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "Run the DiscIt catalog sync now",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/catalog/sync",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "catalog",
                "sync"
              ]
            },
            "description": "Run the DiscIt catalog sync now"
          },
          "response": []
        },
        {
          "name": "Embed the discs whose vectors are missing or stale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/embeddings/backfill?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "embeddings",
                "backfill"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10",
                  "description": "",
                  "disabled": false
                }
              ]
            },
            "description": "Embed the discs whose vectors are missing or stale"
          },
          "response": []
        },
        {
          "name": "Embed the entire catalog, resuming until nothing is left",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/embeddings/backfill/all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "embeddings",
                "backfill",
                "all"
              ]
            },
            "description": "Returns immediately with 202; embedding the whole catalog outlasts any sensible request timeout. Poll GET /admin/embeddings/progress. Safe to re-run: already-embedded discs are detected by content hash and skipped."
          },
          "response": []
        },
        {
          "name": "Progress of the running or most recent full backfill",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/embeddings/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "embeddings",
                "progress"
              ]
            },
            "description": "Progress of the running or most recent full backfill"
          },
          "response": []
        },
        {
          "name": "Vector coverage for the active embedding model",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/embeddings/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "embeddings",
                "stats"
              ]
            },
            "description": "Vector coverage for the active embedding model"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Bags",
      "item": [
        {
          "name": "List bag models, optionally only those that fit a given number of discs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bags?capacity=18&brand=Innova&type=BACKPACK",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bags"
              ],
              "query": [
                {
                  "key": "capacity",
                  "value": "18",
                  "description": "",
                  "disabled": false
                },
                {
                  "key": "brand",
                  "value": "Innova",
                  "description": "",
                  "disabled": false
                },
                {
                  "key": "type",
                  "value": "BACKPACK",
                  "description": "",
                  "disabled": false
                }
              ]
            },
            "description": "Specs are hand-researched from manufacturer listings. Where a maker does not publish a figure the field is null rather than estimated \u2014 `source` says where each row came from."
          },
          "response": []
        },
        {
          "name": "Bag manufacturers in the catalog",
          "request": {
            "method": "GET",
